{
    "$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**", "!**/.next", "!**/cache", "!**/node_modules"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "useValidAnchor": "off",
                "useSemanticElements": "off",
                "noLabelWithoutControl": "off",
                "useButtonType": "off",
                "useKeyWithClickEvents": "off",
                "noNoninteractiveTabindex": "off",
                "noStaticElementInteractions": "off",
                "useAriaPropsSupportedByRole": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noArrayIndexKey": "off",
                "noImplicitAnyLet": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            },
            "performance": {
                "noImgElement": "off"
            }
        }
    }
}
